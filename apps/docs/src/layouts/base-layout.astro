---
import GlobalNav from "#components/global-nav/index.astro";
import { LIBRARY_COOKIE, libraryFromPath, resolveLibrary } from '#utils/library'
import { getPageLinks } from '#utils/metadata'
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";

import "@docsearch/css/dist/style.css";
import "#styles/main.css";

// import '@fontsource-variable/open-sans'
// import '@fontsource-variable/public-sans'
// import '@fontsource-variable/roboto-mono'
// import '@fontsource-variable/source-sans-3'
// import '@fontsource-variable/merriweather'

interface Props {
  title?: string;
  description: string;
  ogImageUrl?: URL;
  markdown?: boolean
}

const SITE_NAME = "USWDS + Tailwind";

const {
  title = SITE_NAME,
  description,
  markdown = false,
} = Astro.props;
const links = getPageLinks(Astro.url.pathname, Astro.site ?? Astro.url)
const { canonical } = links
const ogImageUrl = new URL(Astro.props.ogImageUrl ?? '/og.jpg', canonical)

if (title) ogImageUrl.searchParams.set("title", title);
if (description) ogImageUrl.searchParams.set("description", description);

const metaTitle = title === SITE_NAME ? title : `${title} - ${SITE_NAME}`;
const library = resolveLibrary(Astro.url, Astro.cookies.get(LIBRARY_COOKIE)?.value)

// Canonical docs routes carry the preference into shared design pages, even
// without JavaScript. Shared pages can then vary by cookie.
const pathLibrary = libraryFromPath(Astro.url.pathname)
if (pathLibrary)
  Astro.cookies.set(LIBRARY_COOKIE, pathLibrary, { path: '/', sameSite: 'lax', maxAge: 31536000 })
Astro.response.headers.set('Cache-Control', 'private, no-store')
---

<!doctype html>
<html lang="en" data-library={library}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={metaTitle}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title: metaTitle,
          type: "website",
          image: ogImageUrl.toString(),
          url: canonical,
        },
        optional: {
          description,
          siteName: SITE_NAME,
        },
        image: {
          width: 1200,
          height: 630,
          alt: `Project logo resembling the American flag. White text on a dark blue background. Text reads: ${title || "USWDS + Tailwind"}. ${description}`,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: metaTitle,
        description,
        image: ogImageUrl,
      }}
      extend={{
        link: [
          { rel: "sitemap", href: "/sitemap.xml" },
          ...(markdown ? [{ rel: 'alternate', type: 'text/markdown', href: links.markdown.href, title: `${title} (Markdown)` }] : []),
        ],
        meta: [
          { name: "generator", content: Astro.generator },
          { name: "color-scheme", content: "only light" },
        ],
      }}
    />

    <script>
      import { destroyAllComponents, initAll } from "@uswds-tailwind/compat";

      document.addEventListener("astro:page-load", () => {
        // React and compat share data-part names, including accordion-root.
        // Only vanilla pages contain compat-owned demos.
        if (document.documentElement.dataset.library === "vanilla")
          initAll();
      });
      document.addEventListener("astro:before-swap", destroyAllComponents);
    </script>
    <script>
      import '#utils/library-client'
    </script>

    <!-- Fathom - beautiful, simple website analytics -->
    {
      import.meta.env.PROD ? (
        <script
          is:inline
          src="https://cdn.usefathom.com/script.js"
          data-site="JRNISGUF"
          data-spa="auto"
          defer
        />
      ) : null
    }
    <!-- / Fathom -->
    <ClientRouter />
  </head>
  <body class="h-full font-public-sans">
    <a
      class="sr-only rounded-sm leading-none text-blue-60v px-5 py-3 ring-inset ring-2 ring-blue-60v hover:ring-blue-warm-70v hover:text-blue-warm-70v active:ring-blue-warm-80v active:text-blue-warm-80v focus:outline-4 focus:outline-offset-4 focus:outline-blue-40v focus:top-0 focus:left-0 focus:h-auto focus:w-auto focus:m-0 focus:[clip:unset] bg-white z-50"
      href="#main-content">Skip to main content</a
    >
    <GlobalNav />
    <slot />
  </body>
</html>
