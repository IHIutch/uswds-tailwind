{
  "name": "Combobox",
  "intro": "Root owns options and selection. Place Label, Control, Input, List, and option Item parts inside it.",
  "parts": [
    {
      "name": "Root",
      "element": "div",
      "description": "Owns selection, query, filtering, and open state.",
      "props": [
        {
          "name": "options",
          "type": "{ value: string; text: string; disabled?: boolean }[]",
          "description": "Options available for selection."
        },
        {
          "name": "value",
          "type": "string",
          "description": "Controlled selected value."
        },
        {
          "name": "defaultValue",
          "type": "string",
          "description": "Initial selected value."
        },
        {
          "name": "inputValue",
          "type": "string",
          "description": "Controlled query text."
        },
        {
          "name": "defaultInputValue",
          "type": "string",
          "description": "Initial query text."
        },
        {
          "name": "onValueChange",
          "type": "(value: string) => void",
          "description": "Receives selection changes."
        },
        {
          "name": "onInputValueChange",
          "type": "({ inputValue: string }) => void",
          "description": "Receives query changes."
        },
        {
          "name": "onOpenChange",
          "type": "({ open: boolean }) => void",
          "description": "Receives list visibility changes."
        },
        {
          "name": "customFilter",
          "type": "(query, options) => options",
          "description": "Overrides option filtering."
        },
        {
          "name": "disableFiltering",
          "type": "boolean",
          "description": "Shows supplied options without built-in filtering."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "description": "Disables selection."
        },
        {
          "name": "required",
          "type": "boolean",
          "description": "Requires a value."
        },
        {
          "name": "showClearButton",
          "type": "boolean",
          "description": "Renders the clear button when true."
        },
        {
          "name": "showToggleButton",
          "type": "boolean",
          "description": "Renders the toggle button when true."
        }
      ],
      "data": [
        {
          "attribute": "data-state",
          "value": "open | closed",
          "purpose": "Style the open and closed states."
        },
        {
          "attribute": "data-disabled",
          "value": "Present when disabled",
          "purpose": "Style the disabled state."
        }
      ]
    },
    {
      "name": "Label",
      "element": "label",
      "description": "Names the combobox.",
      "data": [
        {
          "attribute": "data-disabled",
          "value": "Present when disabled",
          "purpose": "Style the disabled state."
        }
      ]
    },
    {
      "name": "Control",
      "element": "div",
      "description": "Groups the input and option buttons."
    },
    {
      "name": "Input",
      "element": "input",
      "description": "Receives filter text.",
      "data": [
        {
          "attribute": "data-state",
          "value": "open | closed",
          "purpose": "Style the open and closed states."
        }
      ]
    },
    {
      "name": "List",
      "element": "ul",
      "description": "Displays matching options.",
      "props": [
        {
          "name": "children",
          "type": "ReactNode | ({ options }) => ReactNode",
          "description": "Can render from filtered options."
        }
      ],
      "data": [
        {
          "attribute": "data-state",
          "value": "open | closed",
          "purpose": "Style the open and closed states."
        }
      ]
    },
    {
      "name": "Item",
      "element": "li",
      "description": "Use its value, text, and index to match an option in the filtered list.",
      "props": [
        {
          "name": "value",
          "type": "string (required)",
          "description": "Option value."
        },
        {
          "name": "text",
          "type": "string (required)",
          "description": "Option label."
        },
        {
          "name": "index",
          "type": "number (required)",
          "description": "Index in the rendered option list."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "description": "Disables this option."
        }
      ],
      "data": [
        {
          "attribute": "data-selected",
          "value": "Present when selected",
          "purpose": "Styles the selected option."
        },
        {
          "attribute": "data-highlighted",
          "value": "Present when highlighted",
          "purpose": "Styles the highlighted option."
        },
        {
          "attribute": "data-disabled",
          "value": "Present when disabled",
          "purpose": "Style the disabled state."
        }
      ]
    },
    {
      "name": "EmptyItem",
      "element": "li",
      "description": "Displays when no options match."
    },
    {
      "name": "IndicatorGroup",
      "element": "div",
      "description": "Groups the clear and toggle buttons."
    },
    {
      "name": "ClearButton",
      "element": "button",
      "description": "Clears the selected option."
    },
    {
      "name": "ToggleButton",
      "element": "button",
      "description": "Opens or closes the option list."
    }
  ],
  "accessibility": "Provide a visible Label or another accessible name. Keep Item indices aligned with the filtered options passed to List."
}
