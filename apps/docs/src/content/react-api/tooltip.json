{
  "name": "Tooltip",
  "intro": "Use Root with Trigger and Content, or the Tooltip convenience component for a single trigger.",
  "parts": [
    {
      "name": "Root",
      "element": "div",
      "description": "Owns the tooltip state and text.",
      "props": [
        {
          "name": "content",
          "type": "string (required)",
          "description": "Text shown in the tooltip."
        },
        {
          "name": "position",
          "type": "Tooltip position",
          "description": "Preferred placement."
        },
        {
          "name": "defaultOpen",
          "type": "boolean",
          "description": "Initially open state."
        },
        {
          "name": "open",
          "type": "boolean",
          "description": "Controlled open state."
        },
        {
          "name": "onOpenChange",
          "type": "({ open: boolean }) => void",
          "description": "Receives requested open-state changes."
        },
        {
          "name": "closeOnEscape",
          "type": "boolean",
          "description": "Allows Escape to dismiss."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "description": "Disables the tooltip."
        }
      ]
    },
    {
      "name": "Trigger",
      "description": "Clones its single child element and adds tooltip trigger behavior.",
      "data": [
        {
          "attribute": "data-state",
          "value": "open | closed",
          "purpose": "Style the open and closed states."
        }
      ]
    },
    {
      "name": "Content",
      "element": "div",
      "description": "Displays the tooltip text.",
      "data": [
        {
          "attribute": "data-state",
          "value": "open | closed",
          "purpose": "Style the open and closed states."
        },
        {
          "attribute": "data-placement",
          "value": "top | bottom | left | right",
          "purpose": "Positions the tooltip."
        },
        {
          "attribute": "data-visible",
          "value": "Present after opening transition",
          "purpose": "Styles the visible state."
        }
      ]
    },
    {
      "name": "Tooltip",
      "description": "Convenience wrapper around Root, Trigger, and Content.",
      "props": [
        {
          "name": "content",
          "type": "string (required)",
          "description": "Tooltip text."
        },
        {
          "name": "position",
          "type": "Tooltip position",
          "description": "Preferred placement."
        }
      ]
    }
  ],
  "accessibility": "Make the trigger keyboard reachable and name the trigger independently of the tooltip content."
}
