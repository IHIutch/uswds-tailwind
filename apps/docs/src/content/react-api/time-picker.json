{
  "name": "TimePicker",
  "intro": "TimePicker uses the Combobox parts. Root supplies half-hour options and time-aware filtering by default; pass options to replace the generated list.",
  "parts": [
    {
      "name": "Root",
      "element": "div",
      "description": "Manages time selection, query text, filtering, and list visibility.",
      "props": [
        {
          "name": "options",
          "type": "{ value: string; label: string }[]",
          "description": "Replaces the generated half-hour time options."
        },
        {
          "name": "defaultValue",
          "type": "string",
          "description": "Initial selected time."
        },
        {
          "name": "onValueChange",
          "type": "({ value, label }) => void",
          "description": "Receives the selected time value and its visible label."
        },
        {
          "name": "disableFiltering",
          "type": "boolean",
          "description": "Shows supplied options without filtering."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "description": "Disables selection.",
          "defaultValue": "false"
        },
        {
          "name": "required",
          "type": "boolean",
          "description": "Requires a value."
        },
        {
          "name": "showClearButton",
          "type": "boolean",
          "description": "Renders the clear button when true.",
          "defaultValue": "true"
        },
        {
          "name": "showToggleButton",
          "type": "boolean",
          "description": "Renders the toggle button when true.",
          "defaultValue": "true"
        }
      ],
      "data": [
        {
          "attribute": "data-state",
          "value": "open | closed",
          "purpose": "Style the open and closed states."
        },
        {
          "attribute": "data-disabled",
          "value": "Present when disabled",
          "purpose": "Style the disabled state."
        }
      ]
    },
    {
      "name": "Label",
      "element": "label",
      "description": "Names the time field."
    },
    {
      "name": "Control",
      "element": "div",
      "description": "Groups the input and buttons."
    },
    {
      "name": "Input",
      "element": "input",
      "description": "Receives a typed time query."
    },
    {
      "name": "List",
      "element": "ul",
      "description": "Displays matching time options.",
      "props": [
        {
          "name": "children",
          "type": "ReactNode | ({ options }) => ReactNode",
          "description": "Renders items from the filtered options or supplied children."
        }
      ],
      "data": [
        {
          "attribute": "data-state",
          "value": "open | closed",
          "purpose": "Style the open and closed states."
        }
      ]
    },
    {
      "name": "Item",
      "element": "li",
      "description": "Spread a rendered option onto Item, including its generated id, value, and label.",
      "props": [
        {
          "name": "id",
          "type": "string (required)",
          "description": "Generated ID from the rendered option."
        },
        {
          "name": "value",
          "type": "string (required)",
          "description": "Option value."
        },
        {
          "name": "label",
          "type": "string (required)",
          "description": "Option label."
        }
      ],
      "data": [
        {
          "attribute": "aria-selected",
          "value": "true | false",
          "purpose": "Styles the selected option."
        },
        {
          "attribute": "data-highlighted",
          "value": "Present when highlighted",
          "purpose": "Styles the highlighted option."
        }
      ]
    },
    {
      "name": "EmptyItem",
      "element": "li",
      "description": "Displays when no option matches."
    },
    {
      "name": "IndicatorGroup",
      "element": "div",
      "description": "Groups clear and toggle buttons."
    },
    {
      "name": "ClearButton",
      "element": "button",
      "description": "Clears the selected time."
    },
    {
      "name": "ToggleButton",
      "element": "button",
      "description": "Opens or closes the option list."
    }
  ],
  "accessibility": "Provide a visible Label or another accessible name. Keep Item indices aligned with the filtered options passed to List."
}
