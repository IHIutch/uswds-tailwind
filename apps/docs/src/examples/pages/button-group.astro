---
import ComponentPreview from '#components/component-preview.astro'
import ButtonGroupDemo from '../button-group-demo'
import buttonGroupSource from '../button-group-demo.tsx?raw'
import ButtonGroupSegmentedDemo from '../button-group-segmented-demo'
import buttonGroupSegmentedSource from '../button-group-segmented-demo.tsx?raw'
import ButtonGroupSegmentedRedDemo from '../button-group-segmented-red-demo'
import buttonGroupSegmentedRedSource from '../button-group-segmented-red-demo.tsx?raw'
import ButtonGroupSegmentedOutlineDemo from '../button-group-segmented-outline-demo'
import buttonGroupSegmentedOutlineSource from '../button-group-segmented-outline-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={buttonGroupSource} language="tsx" filename="button-group-demo.tsx" playgroundFiles={{ 'button-group-demo.tsx': buttonGroupSource }}>
  <ButtonGroupDemo client:load />
</ComponentPreview>

<h3>Segmented</h3>
<ComponentPreview title="Segmented" demo code={buttonGroupSegmentedSource} language="tsx" filename="button-group-segmented-demo.tsx" playgroundFiles={{ 'button-group-segmented-demo.tsx': buttonGroupSegmentedSource }}>
  <ButtonGroupSegmentedDemo client:load />
</ComponentPreview>

<h3>Segmented Red</h3>
<ComponentPreview title="Segmented Red" demo code={buttonGroupSegmentedRedSource} language="tsx" filename="button-group-segmented-red-demo.tsx" playgroundFiles={{ 'button-group-segmented-red-demo.tsx': buttonGroupSegmentedRedSource }}>
  <ButtonGroupSegmentedRedDemo client:load />
</ComponentPreview>

<h3>Segmented Outline</h3>
<ComponentPreview title="Segmented Outline" demo code={buttonGroupSegmentedOutlineSource} language="tsx" filename="button-group-segmented-outline-demo.tsx" playgroundFiles={{ 'button-group-segmented-outline-demo.tsx': buttonGroupSegmentedOutlineSource }}>
  <ButtonGroupSegmentedOutlineDemo client:load />
</ComponentPreview>
