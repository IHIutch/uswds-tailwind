---
import ComponentPreview from '#components/component-preview.astro'
import CheckboxDemo from '../checkbox-demo'
import checkboxSource from '../checkbox-demo.tsx?raw'
import CheckboxTiledDemo from '../checkbox-tiled-demo'
import checkboxTiledSource from '../checkbox-tiled-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={checkboxSource} language="tsx" filename="checkbox-demo.tsx" playgroundFiles={{ 'checkbox-demo.tsx': checkboxSource }}>
  <CheckboxDemo client:load />
</ComponentPreview>

<h3>Tiled</h3>
<ComponentPreview title="Tiled" demo code={checkboxTiledSource} language="tsx" filename="checkbox-tiled-demo.tsx" playgroundFiles={{ 'checkbox-tiled-demo.tsx': checkboxTiledSource }}>
  <CheckboxTiledDemo client:load />
</ComponentPreview>
