---
import ComponentPreview from '#components/component-preview.astro'
import ComboBoxDemo from '../combo-box-demo'
import comboBoxSource from '../combo-box-demo.tsx?raw'
import ComboBoxDefaultValueDemo from '../combo-box-default-value-demo'
import comboBoxDefaultValueSource from '../combo-box-default-value-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={comboBoxSource} language="tsx" filename="combo-box-demo.tsx" playgroundFiles={{ 'combo-box-demo.tsx': comboBoxSource }}>
  <ComboBoxDemo client:load />
</ComponentPreview>

<h3>With Default Value</h3>
<ComponentPreview title="With Default Value" demo code={comboBoxDefaultValueSource} language="tsx" filename="combo-box-default-value-demo.tsx" playgroundFiles={{ 'combo-box-default-value-demo.tsx': comboBoxDefaultValueSource }}>
  <ComboBoxDefaultValueDemo client:load />
</ComponentPreview>
