---
import ComponentPreview from '#components/component-preview.astro'
import ModalDefaultDemo from '../modal-default-demo'
import modalDefaultSource from '../modal-default-demo.tsx?raw'
import ModalLargeDemo from '../modal-large-demo'
import modalLargeSource from '../modal-large-demo.tsx?raw'
import ModalForcedActionDemo from '../modal-forced-action-demo'
import modalForcedActionSource from '../modal-forced-action-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={modalDefaultSource} language="tsx" filename="modal-default-demo.tsx" playgroundFiles={{ 'modal-default-demo.tsx': modalDefaultSource }}>
  <ModalDefaultDemo client:load />
</ComponentPreview>

<h3>Large</h3>
<ComponentPreview title="Large" demo code={modalLargeSource} language="tsx" filename="modal-large-demo.tsx" playgroundFiles={{ 'modal-large-demo.tsx': modalLargeSource }}>
  <ModalLargeDemo client:load />
</ComponentPreview>

<h3>Forced Action</h3>
<ComponentPreview title="Forced Action" demo code={modalForcedActionSource} language="tsx" filename="modal-forced-action-demo.tsx" playgroundFiles={{ 'modal-forced-action-demo.tsx': modalForcedActionSource }}>
  <ModalForcedActionDemo client:load />
</ComponentPreview>
