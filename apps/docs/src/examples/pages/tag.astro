---
import ComponentPreview from '#components/component-preview.astro'
import TagDemo from '../tag-demo'
import tagSource from '../tag-demo.tsx?raw'
import TagLargeDemo from '../tag-large-demo'
import tagLargeSource from '../tag-large-demo.tsx?raw'
import TagVividOrangeDemo from '../tag-vivid-orange-demo'
import tagVividOrangeSource from '../tag-vivid-orange-demo.tsx?raw'
import TagLightGrayDemo from '../tag-light-gray-demo'
import tagLightGraySource from '../tag-light-gray-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={tagSource} language="tsx" filename="tag-demo.tsx" playgroundFiles={{ 'tag-demo.tsx': tagSource }}>
  <TagDemo client:load />
</ComponentPreview>

<h3>Large</h3>
<ComponentPreview title="Large" demo code={tagLargeSource} language="tsx" filename="tag-large-demo.tsx" playgroundFiles={{ 'tag-large-demo.tsx': tagLargeSource }}>
  <TagLargeDemo client:load />
</ComponentPreview>

<h3>Vivid orange</h3>
<ComponentPreview title="Vivid orange" demo code={tagVividOrangeSource} language="tsx" filename="tag-vivid-orange-demo.tsx" playgroundFiles={{ 'tag-vivid-orange-demo.tsx': tagVividOrangeSource }}>
  <TagVividOrangeDemo client:load />
</ComponentPreview>

<h3>Light gray</h3>
<ComponentPreview title="Light gray" demo code={tagLightGraySource} language="tsx" filename="tag-light-gray-demo.tsx" playgroundFiles={{ 'tag-light-gray-demo.tsx': tagLightGraySource }}>
  <TagLightGrayDemo client:load />
</ComponentPreview>
