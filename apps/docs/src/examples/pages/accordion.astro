---
import ComponentPreview from '#components/component-preview.astro'
import AccordionDemo from '../accordion-demo'
import accordionSource from '../accordion-demo.tsx?raw'
import AccordionHeadingsDemo from '../accordion-headings-demo'
import accordionHeadingsSource from '../accordion-headings-demo.tsx?raw'
import AccordionMultipleDemo from '../accordion-multiple-demo'
import accordionMultipleSource from '../accordion-multiple-demo.tsx?raw'
import AccordionBorderedDemo from '../accordion-bordered-demo'
import accordionBorderedSource from '../accordion-bordered-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={accordionSource} language="tsx" filename="accordion-demo.tsx" playgroundFiles={{ 'accordion-demo.tsx': accordionSource }}>
  <AccordionDemo client:load />
</ComponentPreview>

<h3>With headings</h3>
<p>Wrap each trigger in a heading when its panel represents a section of the page. Choose the heading level to fit the page structure.</p>
<ComponentPreview title="With headings" demo code={accordionHeadingsSource} language="tsx" filename="accordion-headings-demo.tsx" playgroundFiles={{ 'accordion-headings-demo.tsx': accordionHeadingsSource }}>
  <AccordionHeadingsDemo client:load />
</ComponentPreview>

<h3>Multiselectable</h3>
<ComponentPreview title="Multiselectable" demo code={accordionMultipleSource} language="tsx" filename="accordion-multiple-demo.tsx" playgroundFiles={{ 'accordion-multiple-demo.tsx': accordionMultipleSource }}>
  <AccordionMultipleDemo client:load />
</ComponentPreview>

<h3>Bordered</h3>
<ComponentPreview title="Bordered" demo code={accordionBorderedSource} language="tsx" filename="accordion-bordered-demo.tsx" playgroundFiles={{ 'accordion-bordered-demo.tsx': accordionBorderedSource }}>
  <AccordionBorderedDemo client:load />
</ComponentPreview>
