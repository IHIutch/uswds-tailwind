---
import ComponentPreview from '#components/component-preview.astro'
import ProcessListDemo from '../process-list-demo'
import processListSource from '../process-list-demo.tsx?raw'
import ProcessListHeadingsDemo from '../process-list-headings-demo'
import processListHeadingsSource from '../process-list-headings-demo.tsx?raw'
import ProcessListNoTextDemo from '../process-list-no-text-demo'
import processListNoTextSource from '../process-list-no-text-demo.tsx?raw'
import ProcessListCustomSizingDemo from '../process-list-custom-sizing-demo'
import processListCustomSizingSource from '../process-list-custom-sizing-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={processListSource} language="tsx" filename="process-list-demo.tsx" playgroundFiles={{ 'process-list-demo.tsx': processListSource }}>
  <ProcessListDemo client:load />
</ComponentPreview>

<h3>With headings</h3>
<p>Place a heading inside each title when the step represents a section of the page. Choose the heading level to fit the page structure.</p>
<ComponentPreview title="With headings" demo code={processListHeadingsSource} language="tsx" filename="process-list-headings-demo.tsx" playgroundFiles={{ 'process-list-headings-demo.tsx': processListHeadingsSource }}>
  <ProcessListHeadingsDemo client:load />
</ComponentPreview>

<h3>No Text</h3>
<ComponentPreview title="No Text" demo code={processListNoTextSource} language="tsx" filename="process-list-no-text-demo.tsx" playgroundFiles={{ 'process-list-no-text-demo.tsx': processListNoTextSource }}>
  <ProcessListNoTextDemo client:load />
</ComponentPreview>

<h3>Custom Sizing</h3>
<ComponentPreview title="Custom Sizing" demo code={processListCustomSizingSource} language="tsx" filename="process-list-custom-sizing-demo.tsx" playgroundFiles={{ 'process-list-custom-sizing-demo.tsx': processListCustomSizingSource }}>
  <ProcessListCustomSizingDemo client:load />
</ComponentPreview>
