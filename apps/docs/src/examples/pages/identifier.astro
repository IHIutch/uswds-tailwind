---
import ComponentPreview from '#components/component-preview.astro'
import IdentifierDemo from '../identifier-demo'
import identifierSource from '../identifier-demo.tsx?raw'
import IdentifierMultipleLogosDemo from '../identifier-multiple-logos-demo'
import identifierMultipleLogosSource from '../identifier-multiple-logos-demo.tsx?raw'
import IdentifierNoLogosDemo from '../identifier-no-logos-demo'
import identifierNoLogosSource from '../identifier-no-logos-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={identifierSource} language="tsx" filename="identifier-demo.tsx" playgroundFiles={{ 'identifier-demo.tsx': identifierSource }}>
  <IdentifierDemo client:load />
</ComponentPreview>
<p class="max-w-prose mb-12">Replace the placeholder seal with your agency logo and update the agency name, domain, and required links for your site. These examples follow the <a href="https://designsystem.digital.gov/components/identifier/">USWDS identifier patterns</a>.</p>

<h3>Multiple parents and logos</h3>
<ComponentPreview title="Multiple parents and logos" demo code={identifierMultipleLogosSource} language="tsx" filename="identifier-multiple-logos-demo.tsx" playgroundFiles={{ 'identifier-multiple-logos-demo.tsx': identifierMultipleLogosSource }}>
  <IdentifierMultipleLogosDemo client:load />
</ComponentPreview>

<h3>No logos</h3>
<ComponentPreview title="No logos" demo code={identifierNoLogosSource} language="tsx" filename="identifier-no-logos-demo.tsx" playgroundFiles={{ 'identifier-no-logos-demo.tsx': identifierNoLogosSource }}>
  <IdentifierNoLogosDemo client:load />
</ComponentPreview>
