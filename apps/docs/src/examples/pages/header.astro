---
import ComponentPreview from '#components/component-preview.astro'
import HeaderDemo from '../header-demo'
import headerSource from '../header-demo.tsx?raw'
import HeaderExtendedDemo from '../header-extended-demo'
import headerExtendedSource from '../header-extended-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={headerSource} language="tsx" filename="header-demo.tsx" playgroundFiles={{ 'header-demo.tsx': headerSource }}>
  <HeaderDemo client:load />
</ComponentPreview>

<h3>Extended</h3>
<ComponentPreview title="Extended" demo code={headerExtendedSource} language="tsx" filename="header-extended-demo.tsx" playgroundFiles={{ 'header-extended-demo.tsx': headerExtendedSource }}>
  <HeaderExtendedDemo client:load />
</ComponentPreview>
