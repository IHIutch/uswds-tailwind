---
import ComponentPreview from '#components/component-preview.astro'
import FieldInputDemo from '../field-input-demo'
import fieldInputSource from '../field-input-demo.tsx?raw'
import FieldErrorDemo from '../field-error-demo'
import fieldErrorSource from '../field-error-demo.tsx?raw'
import FieldSelectDemo from '../field-select-demo'
import fieldSelectSource from '../field-select-demo.tsx?raw'
import FieldTextareaDemo from '../field-textarea-demo'
import fieldTextareaSource from '../field-textarea-demo.tsx?raw'
import FieldFieldsetDemo from '../field-fieldset-demo'
import fieldFieldsetSource from '../field-fieldset-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>
<p class="max-w-prose">Use <code>Field.Root</code> when you want a React form control to share a label, hint, and validation state. Wrap one control per field. <code>Field.Label</code> and <code>Field.Description</code> provide the control’s label and accessible description; <code>Input</code>, <code>Textarea</code>, and <code>Select.Field</code> read that context.</p>

<h3>Input and hint</h3>
<ComponentPreview title="Input and hint" demo code={fieldInputSource} language="tsx" filename="field-input-demo.tsx" playgroundFiles={{ 'field-input-demo.tsx': fieldInputSource }}>
  <FieldInputDemo client:load />
</ComponentPreview>

<h3>Error message</h3>
<p class="max-w-prose">Set <code>invalid</code> on <code>Field.Root</code> after validation. <code>Field.ErrorMessage</code> then appears, and the control receives <code>aria-invalid</code> and a description that includes the error. <code>required</code> and <code>disabled</code> on the root also reach the control.</p>
<ComponentPreview title="Error message" demo code={fieldErrorSource} language="tsx" filename="field-error-demo.tsx" playgroundFiles={{ 'field-error-demo.tsx': fieldErrorSource }}>
  <FieldErrorDemo client:load />
</ComponentPreview>

<h3>Select</h3>
<ComponentPreview title="Select" demo code={fieldSelectSource} language="tsx" filename="field-select-demo.tsx" playgroundFiles={{ 'field-select-demo.tsx': fieldSelectSource }}>
  <FieldSelectDemo client:load />
</ComponentPreview>

<h3>Textarea</h3>
<ComponentPreview title="Textarea" demo code={fieldTextareaSource} language="tsx" filename="field-textarea-demo.tsx" playgroundFiles={{ 'field-textarea-demo.tsx': fieldTextareaSource }}>
  <FieldTextareaDemo client:load />
</ComponentPreview>

<h3>Fieldset</h3>
<p class="max-w-prose">Use <code>Fieldset.Root</code> to group related controls and <code>Fieldset.Legend</code> to name the group. Each nested <code>Field.Root</code> keeps its own label and control association.</p>
<ComponentPreview title="Fieldset" demo code={fieldFieldsetSource} language="tsx" filename="field-fieldset-demo.tsx" playgroundFiles={{ 'field-fieldset-demo.tsx': fieldFieldsetSource }}>
  <FieldFieldsetDemo client:load />
</ComponentPreview>
