---
import ComponentPreview from '#components/component-preview.astro'
import CardVerticalDemo from '../card-vertical-demo'
import cardVerticalSource from '../card-vertical-demo.tsx?raw'
import CardHorizontalDemo from '../card-horizontal-demo'
import cardHorizontalSource from '../card-horizontal-demo.tsx?raw'
import CardGroupDemo from '../card-group-demo'
import cardGroupSource from '../card-group-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Vertical</h3>
<ComponentPreview title="Vertical" demo code={cardVerticalSource} language="tsx" filename="card-vertical-demo.tsx" playgroundFiles={{ 'card-vertical-demo.tsx': cardVerticalSource }}>
  <CardVerticalDemo client:load />
</ComponentPreview>

<h3>Horizontal</h3>
<ComponentPreview title="Horizontal" demo code={cardHorizontalSource} language="tsx" filename="card-horizontal-demo.tsx" playgroundFiles={{ 'card-horizontal-demo.tsx': cardHorizontalSource }}>
  <CardHorizontalDemo client:load />
</ComponentPreview>

<h3>Group</h3>
<ComponentPreview title="Group" demo code={cardGroupSource} language="tsx" filename="card-group-demo.tsx" playgroundFiles={{ 'card-group-demo.tsx': cardGroupSource }}>
  <CardGroupDemo client:load />
</ComponentPreview>
