---
import ComponentPreview from '#components/component-preview.astro'
import SelectDemo from '../select-demo'
import selectSource from '../select-demo.tsx?raw'
import SelectDisabledDemo from '../select-disabled-demo'
import selectDisabledSource from '../select-disabled-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={selectSource} language="tsx" filename="select-demo.tsx" playgroundFiles={{ 'select-demo.tsx': selectSource }}>
  <SelectDemo client:load />
</ComponentPreview>

<h3>Disabled</h3>
<ComponentPreview title="Disabled" demo code={selectDisabledSource} language="tsx" filename="select-disabled-demo.tsx" playgroundFiles={{ 'select-disabled-demo.tsx': selectDisabledSource }}>
  <SelectDisabledDemo client:load />
</ComponentPreview>
