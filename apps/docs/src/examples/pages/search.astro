---
import ComponentPreview from '#components/component-preview.astro'
import SearchDemo from '../search-demo'
import searchSource from '../search-demo.tsx?raw'
import SearchLargeDemo from '../search-large-demo'
import searchLargeSource from '../search-large-demo.tsx?raw'
import SearchIconButtonDemo from '../search-icon-button-demo'
import searchIconButtonSource from '../search-icon-button-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={searchSource} language="tsx" filename="search-demo.tsx" playgroundFiles={{ 'search-demo.tsx': searchSource }}>
  <SearchDemo client:load />
</ComponentPreview>

<h3>Large</h3>
<ComponentPreview title="Large" demo code={searchLargeSource} language="tsx" filename="search-large-demo.tsx" playgroundFiles={{ 'search-large-demo.tsx': searchLargeSource }}>
  <SearchLargeDemo client:load />
</ComponentPreview>

<h3>Icon Button</h3>
<ComponentPreview title="Icon Button" demo code={searchIconButtonSource} language="tsx" filename="search-icon-button-demo.tsx" playgroundFiles={{ 'search-icon-button-demo.tsx': searchIconButtonSource }}>
  <SearchIconButtonDemo client:load />
</ComponentPreview>
