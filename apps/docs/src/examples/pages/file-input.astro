---
import ComponentPreview from '#components/component-preview.astro'
import FileInputDemo from '../file-input-demo'
import fileInputSource from '../file-input-demo.tsx?raw'
import FileInputSpecificTypesDemo from '../file-input-specific-types-demo'
import fileInputSpecificTypesSource from '../file-input-specific-types-demo.tsx?raw'
import FileInputMultipleDemo from '../file-input-multiple-demo'
import fileInputMultipleSource from '../file-input-multiple-demo.tsx?raw'
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={fileInputSource} language="tsx" filename="file-input-demo.tsx" playgroundFiles={{ 'file-input-demo.tsx': fileInputSource }}>
  <FileInputDemo client:load />
</ComponentPreview>

<h3>Specific File Types</h3>
<ComponentPreview title="Specific File Types" demo code={fileInputSpecificTypesSource} language="tsx" filename="file-input-specific-types-demo.tsx" playgroundFiles={{ 'file-input-specific-types-demo.tsx': fileInputSpecificTypesSource }}>
  <FileInputSpecificTypesDemo client:load />
</ComponentPreview>

<h3>Accept Multiple Files</h3>
<ComponentPreview title="Accept Multiple Files" demo code={fileInputMultipleSource} language="tsx" filename="file-input-multiple-demo.tsx" playgroundFiles={{ 'file-input-multiple-demo.tsx': fileInputMultipleSource }}>
  <FileInputMultipleDemo client:load />
</ComponentPreview>
