---
import ComponentPreview from '#components/component-preview.astro'
import { Code } from 'astro-expressive-code/components'
import StepIndicatorDemo from '../step-indicator-demo'
import stepIndicatorSource from '../step-indicator-demo.tsx?raw'
import StepIndicatorCenteredDemo from '../step-indicator-centered-demo'
import stepIndicatorCenteredSource from '../step-indicator-centered-demo.tsx?raw'
import StepIndicatorCountersDemo from '../step-indicator-counters-demo'
import stepIndicatorCountersSource from '../step-indicator-counters-demo.tsx?raw'
import StepIndicatorCountersSmallDemo from '../step-indicator-counters-small-demo'
import stepIndicatorCountersSmallSource from '../step-indicator-counters-small-demo.tsx?raw'
import StepIndicatorNoLabelsDemo from '../step-indicator-no-labels-demo'
import stepIndicatorNoLabelsSource from '../step-indicator-no-labels-demo.tsx?raw'

const stepIndicatorShortcut = `<StepIndicator.List>
  <StepIndicator.Segments />
</StepIndicator.List>`
const stepIndicatorExpanded = `<StepIndicator.List>
  {({ steps }) =>
    steps.map(step => (
      <StepIndicator.ListItem key={step.label} status={step.status}>
        <StepIndicator.Segment status={step.status}>
          {step.label}
        </StepIndicator.Segment>
      </StepIndicator.ListItem>
    ))}
</StepIndicator.List>`
---

<h2 id="examples">Examples</h2>

<h3>Default</h3>
<ComponentPreview title="Default" demo code={stepIndicatorSource} language="tsx" filename="step-indicator-demo.tsx" playgroundFiles={{ 'step-indicator-demo.tsx': stepIndicatorSource }}>
  <StepIndicatorDemo client:load />
</ComponentPreview>
<div class="max-w-prose mb-12">
  <h4>Segments shortcut</h4>
  <p><code>StepIndicator.Segments</code> renders a <code>ListItem</code> and <code>Segment</code> for each step, passing the computed status to both. Inside <code>StepIndicator.List</code>, this:</p>
  <Code code={stepIndicatorShortcut} lang="tsx" />
  <p>is shorthand for the render function used in the full example above:</p>
  <Code code={stepIndicatorExpanded} lang="tsx" />
                    </div>

<h3>Centered</h3>
<ComponentPreview title="Centered" demo code={stepIndicatorCenteredSource} language="tsx" filename="step-indicator-centered-demo.tsx" playgroundFiles={{ 'step-indicator-centered-demo.tsx': stepIndicatorCenteredSource }}>
  <StepIndicatorCenteredDemo client:load />
</ComponentPreview>

