---
import ComponentPreview from './component-preview.astro'

interface Props {
  title: string
  /** TSX filename without its extension, relative to src/examples. */
  example: string
  playgroundDependencies?: Record<string, string>
}

const { title, example, playgroundDependencies } = Astro.props
const sources = import.meta.glob<string>('../examples/*.tsx', { query: '?raw', import: 'default' })
const filename = `${example}.tsx`
const loadSource = sources[`../examples/${filename}`]
if (!loadSource)
  throw new Error(`Unknown React preview source: ${filename}`)
const source = await loadSource()
---

<ComponentPreview title={title} demo code={source} language="tsx" filename={filename} playgroundFiles={{ [filename]: source }} playgroundDependencies={playgroundDependencies}>
  <slot />
</ComponentPreview>
