---
import type { Library } from '#content/component-coverage'
import Alert from '#components/alert.astro'
import ComponentPreview from '#components/component-preview.astro'
import ContentList from '#components/content-list.astro'
import TableOfContents from '#components/table-of-contents.astro'
import { componentCoverage } from '#content/component-coverage'

import BaseLayout from '#layouts/base-layout.astro'
import ContentLayout from '#layouts/content-layout.astro'
import { libraryHref } from '#utils/library'
import { Code } from 'astro-expressive-code/components'
import { getEntry, render } from 'astro:content'
import AccordionBorderedDemo from '../examples/accordion-bordered-demo'
import accordionBorderedSource from '../examples/accordion-bordered-demo.tsx?raw'
import AccordionDemo from '../examples/accordion-demo'
import accordionSource from '../examples/accordion-demo.tsx?raw'
import AccordionHeadingsDemo from '../examples/accordion-headings-demo'
import accordionHeadingsSource from '../examples/accordion-headings-demo.tsx?raw'
import AccordionMultipleDemo from '../examples/accordion-multiple-demo'
import accordionMultipleSource from '../examples/accordion-multiple-demo.tsx?raw'
import AlertDemo from '../examples/alert-demo'
import alertSource from '../examples/alert-demo.tsx?raw'
import AlertNoIconDemo from '../examples/alert-no-icon-demo'
import alertNoIconSource from '../examples/alert-no-icon-demo.tsx?raw'
import AlertSlimDemo from '../examples/alert-slim-demo'
import alertSlimSource from '../examples/alert-slim-demo.tsx?raw'
import AlertSlimNoIconDemo from '../examples/alert-slim-no-icon-demo'
import alertSlimNoIconSource from '../examples/alert-slim-no-icon-demo.tsx?raw'
import BreadcrumbDemo from '../examples/breadcrumb-demo'
import breadcrumbSource from '../examples/breadcrumb-demo.tsx?raw'
import BreadcrumbWrappingDemo from '../examples/breadcrumb-wrapping-demo'
import breadcrumbWrappingSource from '../examples/breadcrumb-wrapping-demo.tsx?raw'
import ButtonDemo from '../examples/button-demo'
import buttonSource from '../examples/button-demo.tsx?raw'
import ButtonGroupDemo from '../examples/button-group-demo'
import buttonGroupSource from '../examples/button-group-demo.tsx?raw'
import ButtonGroupSegmentedDemo from '../examples/button-group-segmented-demo'
import buttonGroupSegmentedSource from '../examples/button-group-segmented-demo.tsx?raw'
import ButtonGroupSegmentedOutlineDemo from '../examples/button-group-segmented-outline-demo'
import buttonGroupSegmentedOutlineSource from '../examples/button-group-segmented-outline-demo.tsx?raw'
import ButtonGroupSegmentedRedDemo from '../examples/button-group-segmented-red-demo'
import buttonGroupSegmentedRedSource from '../examples/button-group-segmented-red-demo.tsx?raw'
import CardGroupDemo from '../examples/card-group-demo'
import cardGroupSource from '../examples/card-group-demo.tsx?raw'
import CardHorizontalDemo from '../examples/card-horizontal-demo'
import cardHorizontalSource from '../examples/card-horizontal-demo.tsx?raw'
import CardVerticalDemo from '../examples/card-vertical-demo'
import cardVerticalSource from '../examples/card-vertical-demo.tsx?raw'
import CollectionCalendarDemo from '../examples/collection-calendar-demo'
import collectionCalendarSource from '../examples/collection-calendar-demo.tsx?raw'
import CollectionDemo from '../examples/collection-demo'
import collectionSource from '../examples/collection-demo.tsx?raw'
import CollectionHeadingsDemo from '../examples/collection-headings-demo'
import collectionHeadingsSource from '../examples/collection-headings-demo.tsx?raw'
import CollectionThumbnailDemo from '../examples/collection-thumbnail-demo'
import collectionThumbnailSource from '../examples/collection-thumbnail-demo.tsx?raw'
import FieldErrorDemo from '../examples/field-error-demo'
import fieldErrorSource from '../examples/field-error-demo.tsx?raw'
import FieldInputDemo from '../examples/field-input-demo'
import fieldInputSource from '../examples/field-input-demo.tsx?raw'
import FieldSelectDemo from '../examples/field-select-demo'
import fieldSelectSource from '../examples/field-select-demo.tsx?raw'
import FieldSuccessDemo from '../examples/field-success-demo'
import fieldSuccessSource from '../examples/field-success-demo.tsx?raw'
import FieldTextareaDemo from '../examples/field-textarea-demo'
import fieldTextareaSource from '../examples/field-textarea-demo.tsx?raw'
import IdentifierDemo from '../examples/identifier-demo'
import identifierSource from '../examples/identifier-demo.tsx?raw'
import IdentifierMultipleLogosDemo from '../examples/identifier-multiple-logos-demo'
import identifierMultipleLogosSource from '../examples/identifier-multiple-logos-demo.tsx?raw'
import IdentifierNoLogosDemo from '../examples/identifier-no-logos-demo'
import identifierNoLogosSource from '../examples/identifier-no-logos-demo.tsx?raw'
import InPageNavigationDemo from '../examples/in-page-navigation-demo'
import inPageNavigationSource from '../examples/in-page-navigation-demo.tsx?raw'
import InputGroupDemo from '../examples/input-group-demo'
import inputGroupSource from '../examples/input-group-demo.tsx?raw'
import InputMaskDemo from '../examples/input-mask-demo'
import inputMaskSource from '../examples/input-mask-demo.tsx?raw'
import LinkDemo from '../examples/link-demo'
import linkSource from '../examples/link-demo.tsx?raw'
import MemorableDateDemo from '../examples/memorable-date-demo'
import memorableDateSource from '../examples/memorable-date-demo.tsx?raw'
import PaginationBoundedDemo from '../examples/pagination-bounded-demo'
import paginationBoundedSource from '../examples/pagination-bounded-demo.tsx?raw'
import PaginationUnboundedDemo from '../examples/pagination-unbounded-demo'
import paginationUnboundedSource from '../examples/pagination-unbounded-demo.tsx?raw'
import ProcessListCustomSizingDemo from '../examples/process-list-custom-sizing-demo'
import processListCustomSizingSource from '../examples/process-list-custom-sizing-demo.tsx?raw'
import ProcessListDemo from '../examples/process-list-demo'
import processListSource from '../examples/process-list-demo.tsx?raw'
import ProcessListHeadingsDemo from '../examples/process-list-headings-demo'
import processListHeadingsSource from '../examples/process-list-headings-demo.tsx?raw'
import ProcessListNoTextDemo from '../examples/process-list-no-text-demo'
import processListNoTextSource from '../examples/process-list-no-text-demo.tsx?raw'
import StepIndicatorCenteredDemo from '../examples/step-indicator-centered-demo'
import stepIndicatorCenteredSource from '../examples/step-indicator-centered-demo.tsx?raw'
import StepIndicatorCountersDemo from '../examples/step-indicator-counters-demo'
import stepIndicatorCountersSource from '../examples/step-indicator-counters-demo.tsx?raw'
import StepIndicatorCountersSmallDemo from '../examples/step-indicator-counters-small-demo'
import stepIndicatorCountersSmallSource from '../examples/step-indicator-counters-small-demo.tsx?raw'
import StepIndicatorDemo from '../examples/step-indicator-demo'
import stepIndicatorSource from '../examples/step-indicator-demo.tsx?raw'
import StepIndicatorNoLabelsDemo from '../examples/step-indicator-no-labels-demo'
import stepIndicatorNoLabelsSource from '../examples/step-indicator-no-labels-demo.tsx?raw'
import SummaryBoxDemo from '../examples/summary-box-demo'
import summaryBoxSource from '../examples/summary-box-demo.tsx?raw'
import TagDemo from '../examples/tag-demo'
import tagSource from '../examples/tag-demo.tsx?raw'
import TagLargeDemo from '../examples/tag-large-demo'
import tagLargeSource from '../examples/tag-large-demo.tsx?raw'
import TagLightGrayDemo from '../examples/tag-light-gray-demo'
import tagLightGraySource from '../examples/tag-light-gray-demo.tsx?raw'
import TagVividOrangeDemo from '../examples/tag-vivid-orange-demo'
import tagVividOrangeSource from '../examples/tag-vivid-orange-demo.tsx?raw'

interface Props { slug: string, library: Library }
const { slug, library } = Astro.props
if (!slug) {
  throw new Error('Page not found')
}

const entry = await getEntry('components', slug)
if (!entry) {
  throw new Error('Page not found')
}

const { Content, headings } = await render(entry)
const coverage = componentCoverage[entry.id as keyof typeof componentCoverage]
const reactAvailability = coverage?.react
const blockedVanillaExamples = coverage?.examples.filter(example => example.vanilla.status === 'blocked') ?? []

// const activeHeading = ''
const visibleHeadings = library === 'vanilla' ? headings.filter(h => h.depth <= 3) : []
const paginationShortcut = `<Pagination.List>
  <Pagination.PrevTrigger />
  <Pagination.Pages />
  <Pagination.NextTrigger />
</Pagination.List>`
const paginationExpanded = `<Pagination.List>
  {({ pages }) => (
    <>
      <Pagination.PrevTrigger />
      {pages.map((page, index) =>
        page.type === 'page'
          ? <Pagination.Item key={page.value} value={page.value} />
          : <Pagination.Ellipsis key={'ellipsis-' + index} />,
      )}
      <Pagination.NextTrigger />
    </>
  )}
</Pagination.List>`
const stepIndicatorShortcut = `<StepIndicator.List>
  <StepIndicator.Segments />
</StepIndicator.List>`
const stepIndicatorExpanded = `<StepIndicator.List>
  {({ steps }) =>
    steps.map(step => (
      <StepIndicator.ListItem key={step.label} status={step.status}>
        <StepIndicator.Segment status={step.status}>
          {step.label}
        </StepIndicator.Segment>
      </StepIndicator.ListItem>
    ))}
</StepIndicator.List>`
const inPageNavShortcut = `<InPageNav.List>
  <InPageNav.Items />
</InPageNav.List>`
const inPageNavExpanded = `<InPageNav.List>
  {({ headings }) => headings.map(heading => (
    <InPageNav.Item key={heading.href}>
      <InPageNav.Link href={heading.href} depth={heading.depth}>
        {heading.label}
      </InPageNav.Link>
    </InPageNav.Item>
  ))}
</InPageNav.List>`
const reactExamples = slug === 'button'
  ? [{ heading: 'Examples', source: buttonSource, filename: 'button-demo.tsx', files: { 'button-demo.tsx': buttonSource } }]
  : slug === 'accordion'
    ? [
        { heading: 'Default', source: accordionSource, filename: 'accordion-demo.tsx', files: { 'accordion-demo.tsx': accordionSource } },
        { heading: 'With headings', source: accordionHeadingsSource, filename: 'accordion-headings-demo.tsx', files: { 'accordion-headings-demo.tsx': accordionHeadingsSource } },
        { heading: 'Multiselectable', source: accordionMultipleSource, filename: 'accordion-multiple-demo.tsx', files: { 'accordion-multiple-demo.tsx': accordionMultipleSource } },
        { heading: 'Bordered', source: accordionBorderedSource, filename: 'accordion-bordered-demo.tsx', files: { 'accordion-bordered-demo.tsx': accordionBorderedSource } },
      ]
    : slug === 'alert'
      ? [
          { heading: 'Default', source: alertSource, filename: 'alert-demo.tsx', files: { 'alert-demo.tsx': alertSource } },
          { heading: 'Slim', source: alertSlimSource, filename: 'alert-slim-demo.tsx', files: { 'alert-slim-demo.tsx': alertSlimSource } },
          { heading: 'No Icon', source: alertNoIconSource, filename: 'alert-no-icon-demo.tsx', files: { 'alert-no-icon-demo.tsx': alertNoIconSource } },
          { heading: 'Slim No Icon', source: alertSlimNoIconSource, filename: 'alert-slim-no-icon-demo.tsx', files: { 'alert-slim-no-icon-demo.tsx': alertSlimNoIconSource } },
        ]
      : slug === 'breadcrumb'
        ? [
            { heading: 'Default', source: breadcrumbSource, filename: 'breadcrumb-demo.tsx', files: { 'breadcrumb-demo.tsx': breadcrumbSource } },
            { heading: 'Wrapping', source: breadcrumbWrappingSource, filename: 'breadcrumb-wrapping-demo.tsx', files: { 'breadcrumb-wrapping-demo.tsx': breadcrumbWrappingSource } },
          ]
        : slug === 'button-group'
          ? [
              { heading: 'Default', source: buttonGroupSource, filename: 'button-group-demo.tsx', files: { 'button-group-demo.tsx': buttonGroupSource } },
              { heading: 'Segmented', source: buttonGroupSegmentedSource, filename: 'button-group-segmented-demo.tsx', files: { 'button-group-segmented-demo.tsx': buttonGroupSegmentedSource } },
              { heading: 'Segmented Red', source: buttonGroupSegmentedRedSource, filename: 'button-group-segmented-red-demo.tsx', files: { 'button-group-segmented-red-demo.tsx': buttonGroupSegmentedRedSource } },
              { heading: 'Segmented Outline', source: buttonGroupSegmentedOutlineSource, filename: 'button-group-segmented-outline-demo.tsx', files: { 'button-group-segmented-outline-demo.tsx': buttonGroupSegmentedOutlineSource } },
            ]
          : slug === 'card'
            ? [
                { heading: 'Vertical', source: cardVerticalSource, filename: 'card-vertical-demo.tsx', files: { 'card-vertical-demo.tsx': cardVerticalSource } },
                { heading: 'Horizontal', source: cardHorizontalSource, filename: 'card-horizontal-demo.tsx', files: { 'card-horizontal-demo.tsx': cardHorizontalSource } },
                { heading: 'Group', source: cardGroupSource, filename: 'card-group-demo.tsx', files: { 'card-group-demo.tsx': cardGroupSource } },
              ]
            : slug === 'collection'
              ? [
                  { heading: 'Default', source: collectionSource, filename: 'collection-demo.tsx', files: { 'collection-demo.tsx': collectionSource } },
                  { heading: 'Headings Only', source: collectionHeadingsSource, filename: 'collection-headings-demo.tsx', files: { 'collection-headings-demo.tsx': collectionHeadingsSource } },
                  { heading: 'Calendar', source: collectionCalendarSource, filename: 'collection-calendar-demo.tsx', files: { 'collection-calendar-demo.tsx': collectionCalendarSource } },
                  { heading: 'Media Thumbnail', source: collectionThumbnailSource, filename: 'collection-thumbnail-demo.tsx', files: { 'collection-thumbnail-demo.tsx': collectionThumbnailSource } },
                ]
              : slug === 'field'
                ? [
                    { heading: 'Input and hint', source: fieldInputSource, filename: 'field-input-demo.tsx', files: { 'field-input-demo.tsx': fieldInputSource } },
                    { heading: 'Error message', source: fieldErrorSource, filename: 'field-error-demo.tsx', files: { 'field-error-demo.tsx': fieldErrorSource } },
                    { heading: 'Success state', source: fieldSuccessSource, filename: 'field-success-demo.tsx', files: { 'field-success-demo.tsx': fieldSuccessSource } },
                    { heading: 'Select', source: fieldSelectSource, filename: 'field-select-demo.tsx', files: { 'field-select-demo.tsx': fieldSelectSource } },
                    { heading: 'Textarea', source: fieldTextareaSource, filename: 'field-textarea-demo.tsx', files: { 'field-textarea-demo.tsx': fieldTextareaSource } },
                  ]
              : slug === 'summary-box'
                ? [{ heading: 'Example', source: summaryBoxSource, filename: 'summary-box-demo.tsx', files: { 'summary-box-demo.tsx': summaryBoxSource } }]
                : slug === 'identifier'
                  ? [
                      { heading: 'Default', source: identifierSource, filename: 'identifier-demo.tsx', files: { 'identifier-demo.tsx': identifierSource } },
                      { heading: 'Multiple parents and logos', source: identifierMultipleLogosSource, filename: 'identifier-multiple-logos-demo.tsx', files: { 'identifier-multiple-logos-demo.tsx': identifierMultipleLogosSource } },
                      { heading: 'No logos', source: identifierNoLogosSource, filename: 'identifier-no-logos-demo.tsx', files: { 'identifier-no-logos-demo.tsx': identifierNoLogosSource } },
                    ]
                  : slug === 'in-page-navigation'
                    ? [{ heading: 'Default', source: inPageNavigationSource, filename: 'in-page-navigation-demo.tsx', files: { 'in-page-navigation-demo.tsx': inPageNavigationSource } }]
                  : slug === 'input-group'
                    ? [{ heading: 'Example', source: inputGroupSource, filename: 'input-group-demo.tsx', files: { 'input-group-demo.tsx': inputGroupSource } }]
                  : slug === 'input-mask'
                    ? [{ heading: 'Example', source: inputMaskSource, filename: 'input-mask-demo.tsx', files: { 'input-mask-demo.tsx': inputMaskSource } }]
                  : slug === 'link'
                    ? [{ heading: 'Example', source: linkSource, filename: 'link-demo.tsx', files: { 'link-demo.tsx': linkSource } }]
                  : slug === 'memorable-date'
                    ? [{ heading: 'Example', source: memorableDateSource, filename: 'memorable-date-demo.tsx', files: { 'memorable-date-demo.tsx': memorableDateSource } }]
                : slug === 'pagination'
                  ? [
                      { heading: 'Bounded', source: paginationBoundedSource, filename: 'pagination-bounded-demo.tsx', files: { 'pagination-bounded-demo.tsx': paginationBoundedSource } },
                      { heading: 'Unbounded', source: paginationUnboundedSource, filename: 'pagination-unbounded-demo.tsx', files: { 'pagination-unbounded-demo.tsx': paginationUnboundedSource } },
                    ]
                : slug === 'process-list'
                  ? [
                      { heading: 'Default', source: processListSource, filename: 'process-list-demo.tsx', files: { 'process-list-demo.tsx': processListSource } },
                      { heading: 'With headings', source: processListHeadingsSource, filename: 'process-list-headings-demo.tsx', files: { 'process-list-headings-demo.tsx': processListHeadingsSource } },
                      { heading: 'No Text', source: processListNoTextSource, filename: 'process-list-no-text-demo.tsx', files: { 'process-list-no-text-demo.tsx': processListNoTextSource } },
                      { heading: 'Custom Sizing', source: processListCustomSizingSource, filename: 'process-list-custom-sizing-demo.tsx', files: { 'process-list-custom-sizing-demo.tsx': processListCustomSizingSource } },
                    ]
                  : slug === 'step-indicator'
                    ? [
                        { heading: 'Default', source: stepIndicatorSource, filename: 'step-indicator-demo.tsx', files: { 'step-indicator-demo.tsx': stepIndicatorSource } },
                        { heading: 'Centered', source: stepIndicatorCenteredSource, filename: 'step-indicator-centered-demo.tsx', files: { 'step-indicator-centered-demo.tsx': stepIndicatorCenteredSource } },
                        { heading: 'Counters', source: stepIndicatorCountersSource, filename: 'step-indicator-counters-demo.tsx', files: { 'step-indicator-counters-demo.tsx': stepIndicatorCountersSource } },
                        { heading: 'Counters Small', source: stepIndicatorCountersSmallSource, filename: 'step-indicator-counters-small-demo.tsx', files: { 'step-indicator-counters-small-demo.tsx': stepIndicatorCountersSmallSource } },
                        { heading: 'No Labels', source: stepIndicatorNoLabelsSource, filename: 'step-indicator-no-labels-demo.tsx', files: { 'step-indicator-no-labels-demo.tsx': stepIndicatorNoLabelsSource } },
                      ]
                : slug === 'tag'
                  ? [
                      { heading: 'Default', source: tagSource, filename: 'tag-demo.tsx', files: { 'tag-demo.tsx': tagSource } },
                      { heading: 'Large', source: tagLargeSource, filename: 'tag-large-demo.tsx', files: { 'tag-large-demo.tsx': tagLargeSource } },
                      { heading: 'Vivid orange', source: tagVividOrangeSource, filename: 'tag-vivid-orange-demo.tsx', files: { 'tag-vivid-orange-demo.tsx': tagVividOrangeSource } },
                      { heading: 'Light gray', source: tagLightGraySource, filename: 'tag-light-gray-demo.tsx', files: { 'tag-light-gray-demo.tsx': tagLightGraySource } },
                    ]
    : null
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <ContentLayout>
    <div class="flex w-full">
      <TableOfContents headings={visibleHeadings} />
      <main id="main-content" class="px-4 tablet:px-12 py-12 min-w-0 w-full">
        <div class="flex flex-col mx-auto max-w-6xl">
          <div class="mb-16">
            <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
            <p class="text-xl font-light max-w-prose">
              {entry.data.description}
            </p>
            {library === 'react' && reactAvailability && reactAvailability.kind !== 'component' && (
              <p class="max-w-prose mt-4 text-sm text-gray-70">
                <strong>React availability:</strong> {reactAvailability.note} {reactAvailability.alternative}
                {reactAvailability.alternativePage && <a class="underline ml-1" href={libraryHref(`/components/${reactAvailability.alternativePage}`, library, Astro.url)}>See the related component</a>}
              </p>
            )}
            {library === 'react' && reactAvailability?.kind === 'component' && reactAvailability.note && (
              <p class="max-w-prose mt-4 text-sm text-gray-70">
                <strong>React API:</strong> {reactAvailability.note}
              </p>
            )}
            {library === 'vanilla' && blockedVanillaExamples.length > 0 && (
              <p class="max-w-prose mt-4 text-sm text-gray-70">
                <strong>Vanilla example status ({blockedVanillaExamples.map(example => example.heading).join(', ')}):</strong> {coverage?.publicBlockNotice}
              </p>
            )}
          </div>
          {library === 'vanilla'
? (
            <div class="docs-prose max-w-none [&_>_*:not(.not-docs-prose)]:max-w-prose">
              <Content components={{ ContentList, ComponentPreview, Alert }} />
            </div>
          )
: reactExamples
? (
            <div class="docs-prose max-w-none">
              <h2>Examples</h2>
              {slug === 'field' && <p class="max-w-prose">Use <code>Field.Root</code> when you want a React form control to share a label, hint, and validation state. Wrap one control per field. <code>Field.Label</code> and <code>Field.Description</code> provide the control’s label and accessible description; <code>Input</code>, <code>Textarea</code>, and <code>Select.Field</code> read that context.</p>}
              {reactExamples.map(example => (
                <section aria-label={example.heading}>
                  {(slug === 'accordion' || slug === 'alert' || slug === 'breadcrumb' || slug === 'button-group' || slug === 'card' || slug === 'collection' || slug === 'field' || slug === 'identifier' || slug === 'in-page-navigation' || slug === 'pagination' || slug === 'process-list' || slug === 'step-indicator' || slug === 'tag') && <h3>{example.heading}</h3>}
                  {slug === 'field' && example.heading === 'Error message' && <p class="max-w-prose">Set <code>invalid</code> on <code>Field.Root</code> after validation. <code>Field.ErrorMessage</code> then appears, and the control receives <code>aria-invalid</code> and a description that includes the error. <code>required</code> and <code>disabled</code> on the root also reach the control.</p>}
                  {slug === 'field' && example.heading === 'Success state' && <p class="max-w-prose">Apply the <a href="https://designsystem.digital.gov/components/text-input/">USWDS success style</a> after validation succeeds. It uses a 4px green border and reduced vertical padding.</p>}
                  {slug === 'accordion' && example.heading === 'With headings' && <p>Wrap each trigger in a heading when its panel represents a section of the page. Choose the heading level to fit the page structure.</p>}
                  {slug === 'process-list' && example.heading === 'With headings' && <p>Place a heading inside each title when the step represents a section of the page. Choose the heading level to fit the page structure.</p>}
                  <ComponentPreview
                    title={example.heading}
                    demo
                    code={example.source}
                    language="tsx"
                    filename={example.filename}
                    playgroundFiles={example.files as Record<string, string>}
                  >
                    {slug === 'button' && <ButtonDemo client:load />}
                    {slug === 'accordion' && example.heading === 'Default' && <AccordionDemo client:load />}
                    {slug === 'accordion' && example.heading === 'With headings' && <AccordionHeadingsDemo client:load />}
                    {slug === 'accordion' && example.heading === 'Multiselectable' && <AccordionMultipleDemo client:load />}
                    {slug === 'accordion' && example.heading === 'Bordered' && <AccordionBorderedDemo client:load />}
                    {slug === 'alert' && example.heading === 'Default' && <AlertDemo client:load />}
                    {slug === 'alert' && example.heading === 'Slim' && <AlertSlimDemo client:load />}
                    {slug === 'alert' && example.heading === 'No Icon' && <AlertNoIconDemo client:load />}
                    {slug === 'alert' && example.heading === 'Slim No Icon' && <AlertSlimNoIconDemo client:load />}
                    {slug === 'breadcrumb' && example.heading === 'Default' && <BreadcrumbDemo client:load />}
                    {slug === 'breadcrumb' && example.heading === 'Wrapping' && <BreadcrumbWrappingDemo client:load />}
                    {slug === 'button-group' && example.heading === 'Default' && <ButtonGroupDemo client:load />}
                    {slug === 'button-group' && example.heading === 'Segmented' && <ButtonGroupSegmentedDemo client:load />}
                    {slug === 'button-group' && example.heading === 'Segmented Red' && <ButtonGroupSegmentedRedDemo client:load />}
                    {slug === 'button-group' && example.heading === 'Segmented Outline' && <ButtonGroupSegmentedOutlineDemo client:load />}
                    {slug === 'card' && example.heading === 'Vertical' && <CardVerticalDemo client:load />}
                    {slug === 'card' && example.heading === 'Horizontal' && <CardHorizontalDemo client:load />}
                    {slug === 'card' && example.heading === 'Group' && <CardGroupDemo client:load />}
                    {slug === 'collection' && example.heading === 'Default' && <CollectionDemo client:load />}
                    {slug === 'collection' && example.heading === 'Headings Only' && <CollectionHeadingsDemo client:load />}
                    {slug === 'collection' && example.heading === 'Calendar' && <CollectionCalendarDemo client:load />}
                    {slug === 'collection' && example.heading === 'Media Thumbnail' && <CollectionThumbnailDemo client:load />}
                    {slug === 'field' && example.heading === 'Input and hint' && <FieldInputDemo client:load />}
                    {slug === 'field' && example.heading === 'Error message' && <FieldErrorDemo client:load />}
                    {slug === 'field' && example.heading === 'Success state' && <FieldSuccessDemo client:load />}
                    {slug === 'field' && example.heading === 'Select' && <FieldSelectDemo client:load />}
                    {slug === 'field' && example.heading === 'Textarea' && <FieldTextareaDemo client:load />}
                    {slug === 'summary-box' && <SummaryBoxDemo client:load />}
                    {slug === 'identifier' && example.heading === 'Default' && <IdentifierDemo client:load />}
                    {slug === 'identifier' && example.heading === 'Multiple parents and logos' && <IdentifierMultipleLogosDemo client:load />}
                    {slug === 'identifier' && example.heading === 'No logos' && <IdentifierNoLogosDemo client:load />}
                    {slug === 'in-page-navigation' && <InPageNavigationDemo client:load />}
                    {slug === 'input-group' && <InputGroupDemo client:load />}
                    {slug === 'input-mask' && <InputMaskDemo client:load />}
