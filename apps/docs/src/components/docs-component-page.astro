---
import type { Library } from '#content/component-coverage'
import Alert from '#components/alert.astro'
import ComponentPreview from '#components/component-preview.astro'
import ContentList from '#components/content-list.astro'
import TableOfContents from '#components/table-of-contents.astro'
import { componentCoverage } from '#content/component-coverage'

import BaseLayout from '#layouts/base-layout.astro'
import ContentLayout from '#layouts/content-layout.astro'
import { libraryHref } from '#utils/library'
import { getEntry, render } from 'astro:content'
import AccordionBorderedDemo from '../examples/accordion-bordered-demo'
import accordionBorderedSource from '../examples/accordion-bordered-demo.tsx?raw'
import AccordionDemo from '../examples/accordion-demo'
import accordionSource from '../examples/accordion-demo.tsx?raw'
import AccordionHeadingsDemo from '../examples/accordion-headings-demo'
import accordionHeadingsSource from '../examples/accordion-headings-demo.tsx?raw'
import AccordionMultipleDemo from '../examples/accordion-multiple-demo'
import accordionMultipleSource from '../examples/accordion-multiple-demo.tsx?raw'
import AlertDemo from '../examples/alert-demo'
import alertSource from '../examples/alert-demo.tsx?raw'
import AlertNoIconDemo from '../examples/alert-no-icon-demo'
import alertNoIconSource from '../examples/alert-no-icon-demo.tsx?raw'
import AlertSlimDemo from '../examples/alert-slim-demo'
import alertSlimSource from '../examples/alert-slim-demo.tsx?raw'
import AlertSlimNoIconDemo from '../examples/alert-slim-no-icon-demo'
import alertSlimNoIconSource from '../examples/alert-slim-no-icon-demo.tsx?raw'
import BreadcrumbDemo from '../examples/breadcrumb-demo'
import breadcrumbSource from '../examples/breadcrumb-demo.tsx?raw'
import BreadcrumbWrappingDemo from '../examples/breadcrumb-wrapping-demo'
import breadcrumbWrappingSource from '../examples/breadcrumb-wrapping-demo.tsx?raw'
import ButtonDemo from '../examples/button-demo'
import buttonSource from '../examples/button-demo.tsx?raw'
import ButtonGroupDemo from '../examples/button-group-demo'
import buttonGroupSource from '../examples/button-group-demo.tsx?raw'
import ButtonGroupSegmentedDemo from '../examples/button-group-segmented-demo'
import buttonGroupSegmentedSource from '../examples/button-group-segmented-demo.tsx?raw'
import ButtonGroupSegmentedOutlineDemo from '../examples/button-group-segmented-outline-demo'
import buttonGroupSegmentedOutlineSource from '../examples/button-group-segmented-outline-demo.tsx?raw'
import ButtonGroupSegmentedRedDemo from '../examples/button-group-segmented-red-demo'
import buttonGroupSegmentedRedSource from '../examples/button-group-segmented-red-demo.tsx?raw'
import CardGroupDemo from '../examples/card-group-demo'
import cardGroupSource from '../examples/card-group-demo.tsx?raw'
import CardHorizontalDemo from '../examples/card-horizontal-demo'
import cardHorizontalSource from '../examples/card-horizontal-demo.tsx?raw'
import CardVerticalDemo from '../examples/card-vertical-demo'
import cardVerticalSource from '../examples/card-vertical-demo.tsx?raw'

interface Props { slug: string, library: Library }
const { slug, library } = Astro.props
if (!slug) {
  throw new Error('Page not found')
}

const entry = await getEntry('components', slug)
if (!entry) {
  throw new Error('Page not found')
}

const { Content, headings } = await render(entry)
const coverage = componentCoverage[entry.id as keyof typeof componentCoverage]
const reactAvailability = coverage?.react
const blockedVanillaExamples = coverage?.examples.filter(example => example.vanilla.status === 'blocked') ?? []

// const activeHeading = ''
const visibleHeadings = library === 'vanilla' ? headings.filter(h => h.depth <= 3) : []
const reactExamples = slug === 'button'
  ? [{ heading: 'Examples', source: buttonSource, filename: 'button-demo.tsx', files: { 'button-demo.tsx': buttonSource } }]
  : slug === 'accordion'
    ? [
        { heading: 'Default', source: accordionSource, filename: 'accordion-demo.tsx', files: { 'accordion-demo.tsx': accordionSource } },
        { heading: 'With headings', source: accordionHeadingsSource, filename: 'accordion-headings-demo.tsx', files: { 'accordion-headings-demo.tsx': accordionHeadingsSource } },
        { heading: 'Multiselectable', source: accordionMultipleSource, filename: 'accordion-multiple-demo.tsx', files: { 'accordion-multiple-demo.tsx': accordionMultipleSource } },
        { heading: 'Bordered', source: accordionBorderedSource, filename: 'accordion-bordered-demo.tsx', files: { 'accordion-bordered-demo.tsx': accordionBorderedSource } },
      ]
    : slug === 'alert'
      ? [
          { heading: 'Default', source: alertSource, filename: 'alert-demo.tsx', files: { 'alert-demo.tsx': alertSource } },
          { heading: 'Slim', source: alertSlimSource, filename: 'alert-slim-demo.tsx', files: { 'alert-slim-demo.tsx': alertSlimSource } },
          { heading: 'No Icon', source: alertNoIconSource, filename: 'alert-no-icon-demo.tsx', files: { 'alert-no-icon-demo.tsx': alertNoIconSource } },
          { heading: 'Slim No Icon', source: alertSlimNoIconSource, filename: 'alert-slim-no-icon-demo.tsx', files: { 'alert-slim-no-icon-demo.tsx': alertSlimNoIconSource } },
        ]
      : slug === 'breadcrumb'
        ? [
            { heading: 'Default', source: breadcrumbSource, filename: 'breadcrumb-demo.tsx', files: { 'breadcrumb-demo.tsx': breadcrumbSource } },
            { heading: 'Wrapping', source: breadcrumbWrappingSource, filename: 'breadcrumb-wrapping-demo.tsx', files: { 'breadcrumb-wrapping-demo.tsx': breadcrumbWrappingSource } },
          ]
        : slug === 'button-group'
          ? [
              { heading: 'Default', source: buttonGroupSource, filename: 'button-group-demo.tsx', files: { 'button-group-demo.tsx': buttonGroupSource } },
              { heading: 'Segmented', source: buttonGroupSegmentedSource, filename: 'button-group-segmented-demo.tsx', files: { 'button-group-segmented-demo.tsx': buttonGroupSegmentedSource } },
              { heading: 'Segmented Red', source: buttonGroupSegmentedRedSource, filename: 'button-group-segmented-red-demo.tsx', files: { 'button-group-segmented-red-demo.tsx': buttonGroupSegmentedRedSource } },
              { heading: 'Segmented Outline', source: buttonGroupSegmentedOutlineSource, filename: 'button-group-segmented-outline-demo.tsx', files: { 'button-group-segmented-outline-demo.tsx': buttonGroupSegmentedOutlineSource } },
            ]
          : slug === 'card'
            ? [
                { heading: 'Vertical', source: cardVerticalSource, filename: 'card-vertical-demo.tsx', files: { 'card-vertical-demo.tsx': cardVerticalSource } },
                { heading: 'Horizontal', source: cardHorizontalSource, filename: 'card-horizontal-demo.tsx', files: { 'card-horizontal-demo.tsx': cardHorizontalSource } },
                { heading: 'Group', source: cardGroupSource, filename: 'card-group-demo.tsx', files: { 'card-group-demo.tsx': cardGroupSource } },
              ]
    : null
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <ContentLayout>
    <div class="flex w-full">
      <TableOfContents headings={visibleHeadings} />
      <main id="main-content" class="px-4 tablet:px-12 py-12 min-w-0 w-full">
        <div class="flex flex-col mx-auto max-w-6xl">
          <div class="mb-16">
            <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
            <p class="text-xl font-light max-w-prose">
              {entry.data.description}
            </p>
            {library === 'react' && reactAvailability && reactAvailability.kind !== 'component' && (
              <p class="max-w-prose mt-4 text-sm text-gray-70">
                <strong>React availability:</strong> {reactAvailability.note} {reactAvailability.alternative}
                {reactAvailability.alternativePage && <a class="underline ml-1" href={libraryHref(`/components/${reactAvailability.alternativePage}`, library, Astro.url)}>See the related component</a>}
              </p>
            )}
            {library === 'react' && reactAvailability?.kind === 'component' && reactAvailability.note && (
              <p class="max-w-prose mt-4 text-sm text-gray-70">
                <strong>React API:</strong> {reactAvailability.note}
              </p>
            )}
            {library === 'vanilla' && blockedVanillaExamples.length > 0 && (
              <p class="max-w-prose mt-4 text-sm text-gray-70">
                <strong>Vanilla example status ({blockedVanillaExamples.map(example => example.heading).join(', ')}):</strong> {coverage?.publicBlockNotice}
              </p>
            )}
          </div>
          {library === 'vanilla'
? (
            <div class="docs-prose max-w-none [&_>_*:not(.not-docs-prose)]:max-w-prose">
              <Content components={{ ContentList, ComponentPreview, Alert }} />
            </div>
          )
: reactExamples
? (
            <div class="docs-prose max-w-none">
              <h2>Examples</h2>
              {reactExamples.map(example => (
                <section aria-label={example.heading}>
                  {(slug === 'accordion' || slug === 'alert' || slug === 'breadcrumb' || slug === 'button-group' || slug === 'card') && <h3>{example.heading}</h3>}
                  {slug === 'accordion' && example.heading === 'With headings' && <p>Wrap each trigger in a heading when its panel represents a section of the page. Choose the heading level to fit the page structure.</p>}
                  <ComponentPreview
                    title={example.heading}
                    demo
                    code={example.source}
                    language="tsx"
                    filename={example.filename}
                    playgroundFiles={example.files as Record<string, string>}
                  >
                    {slug === 'button' && <ButtonDemo client:load />}
                    {slug === 'accordion' && example.heading === 'Default' && <AccordionDemo client:load />}
                    {slug === 'accordion' && example.heading === 'With headings' && <AccordionHeadingsDemo client:load />}
                    {slug === 'accordion' && example.heading === 'Multiselectable' && <AccordionMultipleDemo client:load />}
                    {slug === 'accordion' && example.heading === 'Bordered' && <AccordionBorderedDemo client:load />}
                    {slug === 'alert' && example.heading === 'Default' && <AlertDemo client:load />}
                    {slug === 'alert' && example.heading === 'Slim' && <AlertSlimDemo client:load />}
                    {slug === 'alert' && example.heading === 'No Icon' && <AlertNoIconDemo client:load />}
                    {slug === 'alert' && example.heading === 'Slim No Icon' && <AlertSlimNoIconDemo client:load />}
                    {slug === 'breadcrumb' && example.heading === 'Default' && <BreadcrumbDemo client:load />}
                    {slug === 'breadcrumb' && example.heading === 'Wrapping' && <BreadcrumbWrappingDemo client:load />}
                    {slug === 'button-group' && example.heading === 'Default' && <ButtonGroupDemo client:load />}
                    {slug === 'button-group' && example.heading === 'Segmented' && <ButtonGroupSegmentedDemo client:load />}
                    {slug === 'button-group' && example.heading === 'Segmented Red' && <ButtonGroupSegmentedRedDemo client:load />}
                    {slug === 'button-group' && example.heading === 'Segmented Outline' && <ButtonGroupSegmentedOutlineDemo client:load />}
                    {slug === 'card' && example.heading === 'Vertical' && <CardVerticalDemo client:load />}
                    {slug === 'card' && example.heading === 'Horizontal' && <CardHorizontalDemo client:load />}
                    {slug === 'card' && example.heading === 'Group' && <CardGroupDemo client:load />}
                  </ComponentPreview>
                </section>
              ))}
            </div>
          )
: (
            <section aria-labelledby="react-content-status" class="max-w-prose rounded border border-gray-cool-20 bg-gray-5 p-5">
              <h2 id="react-content-status" class="text-xl font-bold mb-2">React documentation status</h2>
              <p>{reactAvailability?.kind === 'component'
                ? 'The React package includes this component. React setup, API details, examples, and playground exports for this page are being prepared.'
                : 'This page has no matching React component export. The availability guidance above describes the supported alternative.'}</p>
              {coverage?.examples.length
? (
                <ul class="list-disc pl-6 mt-3">
                  {coverage.examples.map(example => (
                    <li><strong>{example.heading}:</strong> {example.react.reason}</li>
                  ))}
                </ul>
              )
: null}
            </section>
          )}
        </div>
      </main>
    </div>
  </ContentLayout>
</BaseLayout>
