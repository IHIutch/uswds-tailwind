---
import type { Library } from '#content/component-coverage'
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'
import Alert from '#components/alert.astro'
import ComponentPreview from '#components/component-preview.astro'
import ContentList from '#components/content-list.astro'
import TableOfContents from '#components/table-of-contents.astro'
import { componentCoverage } from '#content/component-coverage'

import BaseLayout from '#layouts/base-layout.astro'
import ContentLayout from '#layouts/content-layout.astro'
import { libraryHref } from '#utils/library'
import { getEntry, render } from 'astro:content'
import ReactApiReference from './react-api-reference.astro'
import { partSlug } from '../reference/react/schema'

interface Props { slug: string, library: Library }
const { slug, library } = Astro.props
if (!slug) {
  throw new Error('Page not found')
}

const entry = await getEntry('components', slug)
if (!entry) {
  throw new Error('Page not found')
}

const { Content, headings } = await render(entry)
const coverage = componentCoverage[entry.id as keyof typeof componentCoverage]
const reactAvailability = coverage?.react
const blockedVanillaExamples = coverage?.examples.filter(example => example.vanilla.status === 'blocked') ?? []

// const activeHeading = ''
const reactReference = (await getEntry('react-api', slug))?.data
const reactReferenceHeadings = reactReference?.parts.map(part => ({
  depth: 3,
  slug: part.slug ?? partSlug(part.name),
  text: part.name,
})) ?? []
if (reactReference?.accessibility) {
  const text = reactReference.accessibilityHeading ?? 'Accessibility'
  reactReferenceHeadings.push({ depth: 3, slug: partSlug(text), text })
}
const reactPageHeadings = reactReference
  ? [
      { depth: 2, slug: 'examples', text: 'Examples' },
      { depth: 2, slug: 'component-api', text: 'Component API' },
      ...reactReferenceHeadings,
    ]
  : []
const visibleHeadings = library === 'vanilla' ? headings.filter(h => h.depth <= 3) : reactPageHeadings
const examplePages = import.meta.glob<{ default: AstroComponentFactory }>('../examples/pages/*.astro')
const loadExamples = library === 'react' ? examplePages[`../examples/pages/${slug}.astro`] : undefined
const Examples = loadExamples ? (await loadExamples()).default : null

---

<BaseLayout title={`${entry.data.title} (${library === 'react' ? 'React' : 'Vanilla'})`} description={entry.data.description} markdown>
  <ContentLayout>
    <div class="flex w-full">
      <TableOfContents headings={visibleHeadings} />
      <main id="main-content" class="px-4 tablet:px-12 py-12 min-w-0 w-full">
        <div class="flex flex-col mx-auto max-w-6xl">
          <div class="mb-16">
            <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
            <p class="text-xl font-light max-w-prose">
              {entry.data.description}
            </p>
            {library === 'react' && reactAvailability && reactAvailability.kind !== 'component' && (
              <p class="max-w-prose mt-4 text-sm text-gray-70">
                <strong>React availability:</strong> {reactAvailability.note} {reactAvailability.alternative}
                {reactAvailability.alternativePage && <a class="underline ml-1" href={libraryHref(`/components/${reactAvailability.alternativePage}`, library, Astro.url)}>See the related component</a>}
              </p>
            )}
            {library === 'react' && reactAvailability?.kind === 'component' && reactAvailability.note && (
              <p class="max-w-prose mt-4 text-sm text-gray-70">
                <strong>React API:</strong> {reactAvailability.note}
              </p>
            )}
            {library === 'vanilla' && blockedVanillaExamples.length > 0 && (
              <p class="max-w-prose mt-4 text-sm text-gray-70">
                <strong>Vanilla example status ({blockedVanillaExamples.map(example => example.heading).join(', ')}):</strong> {coverage?.publicBlockNotice}
              </p>
            )}
          </div>
          {library === 'vanilla'
? (
            <div class="docs-prose max-w-none [&_>_*:not(.not-docs-prose)]:max-w-prose">
              <Content components={{ ContentList, ComponentPreview, Alert }} />
            </div>
          )
: Examples
? (
            <div class="docs-prose max-w-none">
              <Examples />
              {reactReference && <ReactApiReference reference={reactReference} />}
            </div>
          )
: (
            <section aria-labelledby="react-content-status" class="max-w-prose rounded border border-gray-cool-20 bg-gray-5 p-5">
              <h2 id="react-content-status" class="text-xl font-bold mb-2">React documentation status</h2>
              <p>{reactAvailability?.kind === 'component'
                ? 'The React package includes this component. React setup, API details, examples, and playground exports for this page are being prepared.'
                : 'This page has no matching React component export. The availability guidance above describes the supported alternative.'}</p>
              {coverage?.examples.length
? (
                <ul class="list-disc pl-6 mt-3">
                  {coverage.examples.map(example => (
                    <li><strong>{example.heading}:</strong> {example.react.reason}</li>
                  ))}
                </ul>
              )
: null}
            </section>
          )}
        </div>
      </main>
    </div>
  </ContentLayout>
</BaseLayout>
