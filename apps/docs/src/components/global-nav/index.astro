---
import type { NavLinks } from '../../types'
import logo from '#assets/img/logo.svg'
import { resolveLibrary } from '#utils/library'
import { getCollection } from 'astro:content'
import DesktopNav from './desktop-nav.astro'
import MobileNav from './mobile-nav.astro'

const library = resolveLibrary(Astro.url, Astro.cookies.get('docs-library')?.value)

const allComponents = await getCollection('vanilla-components')
const desktopLinks: NavLinks = {
  primary: [
    {
      label: 'Home',
      href: '/',
    },
    {
      label: 'Getting Started',
      href: `/docs/${library}/getting-started`,
    },
    {
      label: 'Components',
      href: `/docs/${library}/components`,
    },
    {
      label: 'JavaScript',
      href: `/docs/${library}/javascript`,
    },
    {
      label: 'Colors',
      href: '/colors',
    },
    {
      label: 'Icons',
      href: '/icons',
    },
    {
      label: 'Typography',
      href: '/typography',
    },
    {
      label: 'About',
      href: '/about',
    },
  ],
}

const mobileLinks: NavLinks = {
  primary: [
    {
      label: 'Home',
      href: '/',
    },
    {
      label: 'Getting Started',
      href: `/docs/${library}/getting-started`,
    },
    {
      label: 'Components',
      children: allComponents.map(c => ({
        label: c.data.title,
        href: `/docs/${library}/components/${c.id}`,
      })),
    },
    {
      label: 'JavaScript',
      href: `/docs/${library}/javascript`,
    },
    {
      label: 'Colors',
      href: '/colors',
    },
    {
      label: 'Icons',
      href: '/icons',
    },
    {
      label: 'Typography',
      href: '/typography',
    },
    {
      label: 'About',
      href: '/about',
    },
  ],
}

const secondary: NavLinks['secondary'] = [
  {
    label: 'Feedback',
    href: 'https://forms.reform.app/szenkB/uswds-tailwind-feedback/sxml6n',
    target: '_blank',
  },
]

---

<header
  id="docs-header"
  class="border-b desktop:border-b-2 border-b-gray-cool-10 z-20 bg-white fixed top-0 inset-x-0"
>
  <div class="desktop:px-8">
    <div
      class="max-w-5xl flex justify-between items-center mx-auto h-12 desktop:h-20"
    >
      <div class="ml-4 desktop:ml-0 flex items-center w-full">
        <em class="font-bold not-italic">
          <a
            class="text-gray-90 text-xl flex gap-3 items-center focus:outline-4 focus:outline-blue-40v"
            href="/"
          >
            <img src={logo.src} class="h-8 w-auto" alt="" />
            <span>USWDS + Tailwind</span>
          </a>
        </em>
        <div class="desktop:hidden ml-auto">
          <MobileNav primary={mobileLinks.primary} secondary={secondary} library={library} />
        </div>
      </div>
    </div>
  </div>
  <div class="hidden desktop:block border-t border-t-gray-cool-10">
    <DesktopNav primary={desktopLinks.primary} secondary={secondary} />
  </div>
</header>

<script>
  import { Accordion } from '@uswds-tailwind/compat/accordion'
  import { Dropdown } from '@uswds-tailwind/compat/dropdown'
  import { Modal } from '@uswds-tailwind/compat/modal'

  let cleanup: (() => void) | undefined

  document.addEventListener('astro:page-load', () => {
    cleanup?.()
    const header = document.getElementById('docs-header')
    const root = document.getElementById('mobile-docs-menu')
    if (!header || !root)
      return

    const accordions = Accordion.createAll(header)
    const dropdowns = Dropdown.createAll(header)
    const menu = Modal.getOrCreateInstance(root)
    const desktop = window.matchMedia('(min-width: 1024px)')
    const closeOnDesktop = () => {
      if (desktop.matches)
        void menu.close()
    }
    const closeOnNavigation = (event: MouseEvent) => {
      if (event.target instanceof Element && event.target.closest('a[href]'))
        void menu.close()
    }

    desktop.addEventListener('change', closeOnDesktop)
    root.addEventListener('click', closeOnNavigation)
    closeOnDesktop()

    cleanup = () => {
      desktop.removeEventListener('change', closeOnDesktop)
      root.removeEventListener('click', closeOnNavigation)
      menu.destroy()
      accordions.forEach(instance => instance.destroy())
      dropdowns.forEach(instance => instance.destroy())
      cleanup = undefined
    }
  })

  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>
