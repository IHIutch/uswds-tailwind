---
import type { Library } from '#content/component-coverage'
import type { NavLinks } from 'types'
import LibraryList from '#components/library-list.astro'
import Search from '#components/search'

type Props = NavLinks & { library: Library }

const { primary, secondary, library } = Astro.props;
---

<details class="group" data-mobile-docs-menu>
  <summary
    class="relative z-50 list-none cursor-pointer uppercase ml-auto leading-none text-white text-sm h-12 px-3 bg-blue-60v hover:bg-blue-warm-70v active:bg-blue-warm-80v focus:outline-4 focus:outline-blue-40v flex items-center"
  ><span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close menu</span></summary>
    <nav
      aria-label="Mobile navigation"
      class="hidden group-open:flex flex-col gap-6 pt-16 pb-4 px-4 bg-white w-60 fixed z-40 right-0 inset-y-0 overflow-auto shadow-lg"
    >
      <Search isMobile client:load />
      <LibraryList library={library} />

      <ul
        class="flex flex-col divide-y divide-gray-10 border-y border-y-gray-10"
      >
        {
          primary
            ? primary.map(item => (
                <li>
                  {item.children !== undefined
? (
                    <details class="group/components">
                        <summary
                          class="text-left group relative flex items-center justify-between w-full py-3 pl-4 leading-none hover:bg-gray-5 focus:z-10 focus:outline-4 focus:outline-blue-40v gap-3 data-[current]:font-bold data-[current]:after:block data-[current]:after:absolute data-[current]:after:bg-blue-60v data-[current]:after:inset-y-1 data-[current]:after:left-0 data-[current]:after:w-1 data-[current]:after:rounded-full"
                          data-current={item.isActive ? true : undefined}
                        >
                          <span class="text-gray-60 group-hover:text-blue-60v group-[[data-current]]:text-blue-60v">
                            {item.label}
                          </span>
                          <span class="h-full flex items-center">
                            <span class="size-5 icon-[material-symbols--add] group-open/components:icon-[material-symbols--remove]" />
                          </span>
                        </summary>
                        <ul>
                          {item.children.map(child => (
                            <li class="border-t border-t-gray-10">
                              <a
                                href={child.href}
                                class="block py-2 pl-8 pr-4 text-gray-60 hover:text-blue-60v hover:bg-gray-5 focus:outline-4 focus:outline-blue-40v"
                                target={child.target}
                              >
                                {child.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                    </details>
                  )
: (
                    <a
                      href={item.href}
                      class="block py-3 px-4 leading-none text-gray-60 hover:text-blue-60v hover:bg-gray-5 focus:outline-4 focus:outline-blue-40v"
                      target={item.target}
                    >
                      {item.label}
                    </a>
                  )}
                </li>
              ))
            : null
        }
      </ul>

      <div class="flex flex-col gap-4">
        {
          secondary && secondary.length > 0
? (
            <ul>
              {secondary.map(item => (
                <li>
                  <a
                    href={item.href}
                    class="inline-flex items-center text-gray-50 text-sm hover:underline hover:text-blue-60v focus:outline-4 focus:outline-blue-40v after:icon-[material-symbols--open-in-new] after:size-4 after:align-middle after:ml-px"
                    target={item.target}
                    rel={item.target === '_blank' ? 'noreferrer' : undefined}
                  >
                    {item.label}

                    {item.target === '_blank'
? (
                      <span class="sr-only">External, opens in a new tab</span>
                    )
: null}
                  </a>
                </li>
              ))}
            </ul>
          )
: null
        }
      </div>

      <p class="text-center">
        <a
          href="https://github.com/IHIutch/uswds-tailwind"
          rel="noreferrer"
          target="_blank"
          class="flex items-center justify-between rounded font-bold leading-none cursor-pointer text-blue-60v px-5 py-3 bg-transparent ring-inset ring-2 ring-blue-60v hover:ring-blue-warm-70v hover:text-blue-warm-70v active:ring-blue-warm-80v active:text-blue-warm-80v focus:outline-4 focus:outline-offset-4 focus:outline-blue-40v"
        >
          <span class="flex items-center gap-2">
            <span class="icon-[fa6-brands--github] size-5"></span>
            <span class="leading-[normal]">GitHub</span>
            <span class="sr-only">External, opens in a new tab</span>
          </span>
          <span class="icon-[material-symbols--open-in-new] size-4"></span>
        </a>
      </p>
    </nav>
</details>

<script>
  const getMobileMenu = () => document.querySelector<HTMLDetailsElement>('[data-mobile-docs-menu]')

  document.addEventListener('keydown', (event) => {
    const menu = getMobileMenu()
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false
      menu.querySelector('summary')?.focus()
    }
  })

  document.addEventListener('focusin', (event) => {
    const menu = getMobileMenu()
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target))
      menu.open = false
  })

  document.addEventListener('pointerdown', (event) => {
    const menu = getMobileMenu()
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target))
      menu.open = false
  })
</script>
