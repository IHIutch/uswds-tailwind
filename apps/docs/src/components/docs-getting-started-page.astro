---
import type { Library } from '#content/component-coverage'
import Alert from '#components/alert.astro'
import ProcessStep from '#components/process-list-step.astro'
import ProcessList from '#components/process-list.astro'
import TableOfContents from '#components/table-of-contents.astro'
import BaseLayout from '#layouts/base-layout.astro'
import ContentLayout from '#layouts/content-layout.astro'
import { getEntry, render } from 'astro:content'

interface Props { library: Library }
const { library } = Astro.props

const post = await getEntry('pages', library === 'react' ? 'getting-started-react' : 'getting-started')
if (!post) {
  throw new Error('Page not found')
}

const { Content, headings } = await render(post)

const visibleHeadings = headings.filter(h => h.depth <= 3)

---

<BaseLayout title={`${post.data.title} (${library === 'react' ? 'React' : 'Vanilla'})`} description={post.data.description} markdown>
  <ContentLayout>
    <div class="flex w-full">
      <TableOfContents headings={visibleHeadings} />
      <main id="main-content" class="px-4 tablet:px-12 py-12 min-w-0 w-full">
        <div class="flex flex-col mx-auto max-w-5xl">
          <div class="max-w-3xl">
            <div class="mb-16">
              <h1 class="text-4xl font-bold mb-4">
                {post.data.title}
              </h1>
              <p class="text-xl font-light max-w-prose">
                {post.data.description}
              </p>
            </div>
            <div class="docs-prose max-w-none">
              <Content components={{ Alert, ProcessList, ProcessStep }} />
            </div>
          </div>
        </div>
      </main>
    </div>
  </ContentLayout>
</BaseLayout>
