---
import Alert from '#components/alert.astro'
import ComponentPreview from '#components/component-preview.astro'
import ContentList from '#components/content-list.astro'
import TableOfContents from '#components/table-of-contents.astro'
import BaseLayout from '#layouts/base-layout.astro'
import ContentLayout from '#layouts/content-layout.astro'
import { prefersMarkdown } from '#utils/handle-prefers-markdown'
import { getPageLinks } from '#utils/metadata'
import { getEntry, render } from 'astro:content'

const { slug } = Astro.params
const entry = slug ? await getEntry('vanilla-components', slug) : undefined
if (!entry)
  return new Response('Page not found', { status: 404 })
if (prefersMarkdown(Astro))
  return Astro.redirect(`${getPageLinks(Astro.url.pathname, Astro.url).markdown.pathname}${Astro.url.search}`)

const { Content, headings } = await render(entry)
---

<BaseLayout title={`${entry.data.title} (Vanilla)`} description={entry.data.description} markdown>
  <ContentLayout>
    <div class="flex w-full">
      <TableOfContents headings={headings.filter(heading => heading.depth <= 3)} />
      <main id="main-content" class="px-4 tablet:px-12 py-12 min-w-0 w-full">
        <div class="flex flex-col mx-auto max-w-6xl">
          <div class="mb-16">
            <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
            <p class="text-xl font-light max-w-prose">{entry.data.description}</p>
          </div>
          <div class="docs-prose max-w-none [&_>_*:not(.not-docs-prose)]:max-w-prose">
            <Content components={{ ContentList, ComponentPreview, Alert }} />
          </div>
        </div>
      </main>
    </div>
  </ContentLayout>
</BaseLayout>
