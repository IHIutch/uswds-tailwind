---
import { getEntry } from 'astro:content'
import DocsComponentPage from '#components/docs-component-page.astro'
import { prefersMarkdown } from '#utils/handle-prefers-markdown'
import { isLibrary, privateRedirect } from '#utils/library'

const { library, slug } = Astro.params
if (!isLibrary(library) || !slug || !await getEntry('components', slug))
  return new Response('Page not found', { status: 404 })
if (prefersMarkdown(Astro))
  return privateRedirect(Astro.redirect(`${Astro.url.pathname}.md${Astro.url.search}`))
---
<DocsComponentPage library={library} slug={slug} />
